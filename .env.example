# ── GCP プロジェクト設定 ───────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=runroute-476505
GOOGLE_CLOUD_REGION=asia-northeast1
STAGING_BUCKET=gs://runroute-476505-agent-staging

# ── サービスアカウント鍵（ローカル開発のみ / コミット禁止） ───────────────
# 本番 Cloud Run / Agent Engine では Workload Identity を使う
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Firebase / Firestore ───────────────────────────────────────────────
FIREBASE_DATABASE_ID=routerun-db

# ── Cloud Functions エンドポイント ─────────────────────────────────────
CF_BASE_URL=https://asia-northeast1-runroute-476505.cloudfunctions.net

# ── テストユーザー（demo のみ） ────────────────────────────────────────
# uid は Firestore で test_ プレフィックスが必須
TEST_UID_SUB4=test_sub4
TEST_UID_FIRSTFULL=test_firstfull
# ID トークン取得方法: Firebase Auth REST API / Firebase Admin SDK カスタムトークン
TEST_ID_TOKEN_SUB4=<firebase-id-token-for-test_sub4>
TEST_ID_TOKEN_FIRSTFULL=<firebase-id-token-for-test_firstfull>

# ── エージェント設定 ───────────────────────────────────────────────────
AGENT_DEMO_ENABLED=true
# PLANNER: Head Coach + Periodization（thinking=2048/4096）
PLANNER_MODEL=gemini-2.5-pro
# FAST: Readiness（thinking=1024 / HRV 解釈）
FAST_MODEL=gemini-2.5-flash
# LITE: Evaluator（パターンマッチのみ、thinking 不要）
LITE_MODEL=gemini-2.5-flash-lite

# ── Agent Engine ────────────────────────────────────────────────────────
AGENT_ENGINE_RESOURCE_NAME=projects/<project>/locations/asia-northeast1/reasoningEngines/<id>
